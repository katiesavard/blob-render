FROM ubuntu:22.04

# Set environment variables
ENV TZ=Etc/UTC
ENV DEBIAN_FRONTEND=noninteractive

# Base system setup and timezone
RUN apt-get update -y && \
    apt-get install -y software-properties-common && \
    apt-get update -y && \
    apt-get upgrade -y && \
    ln -fs /usr/share/zoneinfo/Canada/Mountain /etc/localtime && \
    apt-get install -y tzdata

# Install WSClean + Casacore dependencies
RUN apt-get install -y \
    casacore-dev cmake g++ \
    git pkg-config libblas-dev \
    libboost-date-time-dev libboost-filesystem-dev \
    libboost-program-options-dev libboost-system-dev \
    libcfitsio-dev libfftw3-dev libgsl-dev \
    libhdf5-dev liblapack-dev libopenmpi-dev \
    libpython3-dev python3-pip python3-casacore

# Upgrade pip and install Python packages
RUN python3 -m pip install --upgrade pip && \
    python3 -m pip install \
        "numpy==1.26.*" \
        "astropy>=6.1.7,<7.0" \
        "scipy>=1.14,<1.15" \
        "matplotlib>=3.6,<3.8"

# Build and install WSClean v3.5
RUN git clone -b v3.5 https://gitlab.com/aroffringa/wsclean.git && \
    cd wsclean && \
    mkdir -p build && \
    cd build && \
    cmake ../ -DCMAKE_PREFIX_PATH="../../EveryBeam/" && \
    make -j 4 && \
    make install && \
    cd ../.. && rm -rf wsclean

# Set working directory
WORKDIR /workspace

# Default entrypoint
CMD ["/bin/bash"]